<Window x:Class="ScanSnapShot.Views.ThumbnailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="キャプチャープレビュー"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="320" Height="220">
    <Border Margin="8" Background="#FFFFFF" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8"
            Cursor="Hand" ToolTip="クリックすると画像ファイルを開きます" MouseLeftButtonUp="OnThumbnailClicked">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.3" Color="#101828"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ヘッダー -->
            <Grid Grid.Row="0" Margin="10,8,10,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="キャプチャー完了" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                    </Border>
                    <TextBlock x:Name="TxtFileName" Text="Snap_xxxx.png" FontSize="11" Foreground="#475467"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                </StackPanel>
                <Button Content="✕" Click="OnCloseClicked" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="#98A2B3" FontSize="12" FontWeight="Bold"
                        Cursor="Hand" Padding="4,2" ToolTip="閉じる"/>
            </Grid>

            <!-- プレビュー画像表示エリア -->
            <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="6" Margin="10,0,10,10" ClipToBounds="True">
                <Image x:Name="ImgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
            </Border>
        </Grid>
    </Border>
</Window>
