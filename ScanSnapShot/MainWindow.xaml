<Window x:Class="ScanSnapShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScanSnapShot - 画面監視＆自動キャプチャー"
        Icon="app.ico"
        Height="580" Width="760"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F6F8"
        StateChanged="OnWindowStateChanged"
        Closing="OnWindowClosing">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1D2939"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. エリア設定 -->
        <GroupBox Grid.Row="0" Header="監視・キャプチャー エリア設定">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ScanArea -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="監視エリア (ScanArea)" FontWeight="Bold" Foreground="#027A48" FontSize="13"/>
                        <TextBlock x:Name="TxtScanAreaInfo" Text="X: 0, Y: 0, W: 0, H: 0" Margin="0,6,0,8" Foreground="#344054"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="ScanArea を範囲選択..." Click="OnSelectScanAreaClicked" Background="#ECFDF3" BorderBrush="#A6F4C5" Foreground="#027A48"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- CaptureArea -->
                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="キャプチャーエリア (CaptureArea)" FontWeight="Bold" Foreground="#175CD3" FontSize="13"/>
                        <TextBlock x:Name="TxtCaptureAreaInfo" Text="X: 0, Y: 0, W: 0, H: 0" Margin="0,6,0,8" Foreground="#344054"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="CaptureArea を範囲選択..." Click="OnSelectCaptureAreaClicked" Background="#EFF8FF" BorderBrush="#B2DDFF" Foreground="#175CD3"/>
                            <Button Content="ScanAreaと同じにする" Click="OnSyncCaptureAreaClicked" Background="#F2F4F7" BorderBrush="#D0D5DD"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>

        <!-- 2. パラメータ設定 -->
        <GroupBox Grid.Row="1" Header="監視＆検知パラメータ">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- チェック間隔 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="チェック間隔 (ms):" VerticalAlignment="Center" Margin="0,4">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="300">
                                <TextBlock Text="チェック間隔 (ms)" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="ScanArea（監視エリア）の変化を確認する周期（ミリ秒）です。" TextWrapping="Wrap"/>
                                <TextBlock Text="・設定推奨範囲: 100 〜 60,000 ms (0.1秒〜60秒)" Margin="0,4,0,0" Foreground="#1570EF" TextWrapping="Wrap"/>
                                <TextBlock Text="※短くするほど変化を素早く捉えますが、CPU使用率が上がります。通常は 500 〜 1000 ms を推奨します。" Margin="0,2,0,0" Foreground="#667085" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtInterval" VerticalAlignment="Center" Margin="6,4" Padding="4,2" Text="1000">
                    <TextBox.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="300">
                                <TextBlock Text="チェック間隔 (ms)" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="ScanArea（監視エリア）の変化を確認する周期（ミリ秒）です。" TextWrapping="Wrap"/>
                                <TextBlock Text="・設定推奨範囲: 100 〜 60,000 ms (0.1秒〜60秒)" Margin="0,4,0,0" Foreground="#1570EF" TextWrapping="Wrap"/>
                                <TextBlock Text="※短くするほど変化を素早く捉えますが、CPU使用率が上がります。通常は 500 〜 1000 ms を推奨します。" Margin="0,2,0,0" Foreground="#667085" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- 変化しきい値 -->
                <TextBlock Grid.Row="0" Grid.Column="3" Text="変化しきい値 (%):" VerticalAlignment="Center" Margin="0,4">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="300">
                                <TextBlock Text="変化しきい値 (%)" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="前回取得した画面とのピクセル変化割合（%）がこの値以上になったとき、自動キャプチャーを実行します。" TextWrapping="Wrap"/>
                                <TextBlock Text="・設定推奨範囲: 0.1 〜 100.0 %" Margin="0,4,0,0" Foreground="#1570EF" TextWrapping="Wrap"/>
                                <TextBlock Text="※低すぎるとマウスポインタの通過等のわずかなノイズでも反応します。通常は 1.0 〜 5.0 % 程度を推奨します。" Margin="0,2,0,0" Foreground="#667085" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBox Grid.Row="0" Grid.Column="4" x:Name="TxtSensitivity" VerticalAlignment="Center" Margin="6,4" Padding="4,2" Text="3.0">
                    <TextBox.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="300">
                                <TextBlock Text="変化しきい値 (%)" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="前回取得した画面とのピクセル変化割合（%）がこの値以上になったとき、自動キャプチャーを実行します。" TextWrapping="Wrap"/>
                                <TextBlock Text="・設定推奨範囲: 0.1 〜 100.0 %" Margin="0,4,0,0" Foreground="#1570EF" TextWrapping="Wrap"/>
                                <TextBlock Text="※低すぎるとマウスポインタの通過等のわずかなノイズでも反応します。通常は 1.0 〜 5.0 % 程度を推奨します。" Margin="0,2,0,0" Foreground="#667085" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- クールダウン -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="クールダウン (ms):" VerticalAlignment="Center" Margin="0,4">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="300">
                                <TextBlock Text="クールダウン (ms)" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="キャプチャー撮影直後、次の監視チェックを再開するまでの待機時間（ミリ秒）です。" TextWrapping="Wrap"/>
                                <TextBlock Text="・設定推奨範囲: 0 〜 30,000 ms (0秒〜30秒)" Margin="0,4,0,0" Foreground="#1570EF" TextWrapping="Wrap"/>
                                <TextBlock Text="※動画や画面スクロール等で連続変化が続いた際に、大量の画像ファイルが一気に保存されるのを防ぎます。" Margin="0,2,0,0" Foreground="#667085" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtCooldown" VerticalAlignment="Center" Margin="6,4" Padding="4,2" Text="1500">
                    <TextBox.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="300">
                                <TextBlock Text="クールダウン (ms)" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="キャプチャー撮影直後、次の監視チェックを再開するまでの待機時間（ミリ秒）です。" TextWrapping="Wrap"/>
                                <TextBlock Text="・設定推奨範囲: 0 〜 30,000 ms (0秒〜30秒)" Margin="0,4,0,0" Foreground="#1570EF" TextWrapping="Wrap"/>
                                <TextBlock Text="※動画や画面スクロール等で連続変化が続いた際に、大量の画像ファイルが一気に保存されるのを防ぎます。" Margin="0,2,0,0" Foreground="#667085" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
            </Grid>
        </GroupBox>

        <!-- 3. 保存先フォルダー -->
        <GroupBox Grid.Row="2" Header="保存先設定">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtSaveDirectory" VerticalAlignment="Center" Padding="6,4" IsReadOnly="True" Background="#FCFCFD"/>
                <Button Grid.Column="1" Content="フォルダー参照..." Click="OnBrowseFolderClicked"/>
                <Button Grid.Column="2" Content="フォルダーを開く" Click="OnOpenFolderClicked"/>
            </Grid>
        </GroupBox>

        <!-- 4. 操作ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,8">
            <Button Content="今すぐテストキャプチャー" Click="OnTestCaptureClicked" Padding="14,8"/>
            <Button x:Name="BtnStartStop" Content="監視開始（タスクトレイへ格納）" Click="OnStartStopClicked"
                    Background="#0078D7" Foreground="White" FontWeight="Bold" Padding="18,8"/>
        </StackPanel>

        <!-- 5. ログ / ステータス -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Padding="6">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas, Meiryo" FontSize="11" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- 6. ステータスバー -->
        <StatusBar Grid.Row="5" Margin="0,6,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="待機中" FontWeight="SemiBold" Foreground="#475467"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
