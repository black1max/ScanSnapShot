<Window x:Class="ScanSnapShot.Views.AreaSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="エリア選択"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        MouseDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseUp="OnMouseUp"
        KeyDown="OnKeyDown">
    <Canvas x:Name="OverlayCanvas" Background="#33000000">
        <!-- 選択枠の半透明マスク/ボーダー -->
        <Border x:Name="SelectionBorder"
                BorderBrush="#0078D7"
                BorderThickness="2"
                Background="#220078D7"
                Visibility="Collapsed" />

        <!-- ガイドメッセージ -->
        <Border Background="#CC000000" CornerRadius="4" Padding="10,6" Canvas.Left="20" Canvas.Top="20">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="TitleText" Text="ドラッグしてエリアを選択してください" Foreground="White" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="確定: Enter または ダブルクリック / キャンセル: Esc" Foreground="#DDDDDD" FontSize="12" Margin="0,4,0,0" />
                <TextBlock x:Name="CoordinateText" Text="X: 0, Y: 0, W: 0, H: 0" Foreground="#66D9EF" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
